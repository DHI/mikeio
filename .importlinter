[importlinter]
root_package = mikeio
# Type-only imports do not couple the modules at runtime.
exclude_type_checking_imports = True
# Needed for the contracts that name mikecore and matplotlib.
include_external_packages = True

[importlinter:contract:layers]
name = MIKE IO layers
type = layers
containers = mikeio
# A new module fails the check until it is given a layer.
exhaustive = true
layers =
    generic : pfs
    dfsu
    dfs
    dataset
    _track
    spatial
    _options
    eum
    exceptions : _path : _interpolation : _spectral : _time : _deprecation : _version
ignore_imports =
    # Dataset.to_dfs() dispatches on the output suffix and so has to reach
    # down into the writers of every format, including ones above it in the
    # layering. Deferred into the method body to keep the module importable.
    mikeio.dataset._dataset -> mikeio.dfs._dfs0
    mikeio.dataset._dataset -> mikeio.dfs._dfs1
    mikeio.dataset._dataset -> mikeio.dfs._dfs2
    mikeio.dataset._dataset -> mikeio.dfs._dfs3
    mikeio.dataset._dataset -> mikeio.dfsu
    # Track extraction accepts a dfs0 file or a Dataset as the track input,
    # and builds a Dataset to return the result. Deferred for the same reason.
    mikeio._track -> mikeio.dataset
    mikeio._track -> mikeio.dfs
broken_contract_guidance =
    Import downward only, and from the module that defines the name, not from the root package. Do not add to ignore_imports to make this pass; see adr/011-import-layering.md.

# One contract per subpackage: its modules are imported from outside only
# through its __init__. Modules inside the subpackage import each other freely.

[importlinter:contract:dataset-boundary]
name = dataset is imported through its __init__
type = protected
protected_modules = mikeio.dataset.*
allowed_importers = mikeio.dataset
broken_contract_guidance =
    Import the name from mikeio.dataset. If it is not exported there, export it or move the code; do not add to ignore_imports. See adr/013-subpackage-boundaries.md.

[importlinter:contract:dfsu-boundary]
name = dfsu is imported through its __init__
type = protected
protected_modules = mikeio.dfsu.*
allowed_importers = mikeio.dfsu
broken_contract_guidance =
    Import the name from mikeio.dfsu. If it is not exported there, export it or move the code; do not add to ignore_imports. See adr/013-subpackage-boundaries.md.

[importlinter:contract:eum-boundary]
name = eum is imported through its __init__
type = protected
protected_modules = mikeio.eum.*
allowed_importers = mikeio.eum
broken_contract_guidance =
    Import the name from mikeio.eum. If it is not exported there, export it or move the code; do not add to ignore_imports. See adr/013-subpackage-boundaries.md.

[importlinter:contract:pfs-boundary]
name = pfs is imported through its __init__
type = protected
protected_modules = mikeio.pfs.*
allowed_importers = mikeio.pfs
broken_contract_guidance =
    Import the name from mikeio.pfs. If it is not exported there, export it or move the code; do not add to ignore_imports. See adr/013-subpackage-boundaries.md.

[importlinter:contract:dfs-boundary]
name = dfs is imported through its __init__
type = protected
protected_modules = mikeio.dfs.*
allowed_importers = mikeio.dfs
ignore_imports =
    # Item selection, time step validation and file opening are shared by
    # every dfs format but live in the dfs0-3 base module.
    mikeio.dfsu._dfsu -> mikeio.dfs._dfs
    mikeio.dfsu._factory -> mikeio.dfs._dfs
    mikeio.dfsu._layered -> mikeio.dfs._dfs
    mikeio.dfsu._spectral -> mikeio.dfs._dfs
    mikeio.generic -> mikeio.dfs._dfs
    # Dataset.to_dfs(), as in the layers contract.
    mikeio.dataset._dataset -> mikeio.dfs._dfs0
    mikeio.dataset._dataset -> mikeio.dfs._dfs1
    mikeio.dataset._dataset -> mikeio.dfs._dfs2
    mikeio.dataset._dataset -> mikeio.dfs._dfs3
broken_contract_guidance =
    Import the name from mikeio.dfs. If it is not exported there, export it or move the code; do not add to ignore_imports. See adr/013-subpackage-boundaries.md.

[importlinter:contract:spatial-boundary]
name = spatial is imported through its __init__
type = protected
protected_modules = mikeio.spatial.*
allowed_importers = mikeio.spatial
ignore_imports =
    # The Area type alias and the flexible mesh base classes used in
    # isinstance checks are not exported from mikeio.spatial.
    mikeio.dataset._dataarray -> mikeio.spatial._FM_geometry
    mikeio.dataset._dataarray -> mikeio.spatial._FM_geometry_layered
    mikeio.dataset._dataset -> mikeio.spatial._FM_geometry
    mikeio.dfsu._layered -> mikeio.spatial._FM_geometry
    # Flexible mesh plotting functions are shared with the geometry plotters.
    mikeio.dataset._data_plot -> mikeio.spatial._FM_plot
    mikeio.dfsu._layered -> mikeio.spatial._FM_plot
    mikeio.dfsu._dfsu -> mikeio.spatial._distance
broken_contract_guidance =
    Import the name from mikeio.spatial. If it is not exported there, export it or move the code; do not add to ignore_imports. See adr/013-subpackage-boundaries.md.

[importlinter:contract:pfs-standalone]
name = pfs depends on no data module
type = forbidden
source_modules = mikeio.pfs
forbidden_modules =
    mikeio.dataset
    mikeio.dfs
    mikeio.dfsu
    mikeio.spatial
    mikeio.eum
    mikeio.generic
    mikecore
    matplotlib

[importlinter:contract:mikecore]
name = mikecore is not imported by the data structures
type = forbidden
source_modules =
    mikeio.dataset
    mikeio._track
    mikeio._options
    mikeio._time
    mikeio._interpolation
    mikeio._spectral
    mikeio._path
    mikeio._deprecation
    mikeio.exceptions
forbidden_modules = mikecore
# dataset reaches mikecore through spatial and eum; only the direct import is checked.
allow_indirect_imports = True

[importlinter:contract:matplotlib]
name = matplotlib is not imported by the file modules
type = forbidden
source_modules =
    mikeio.dfs
    mikeio.dfsu
    mikeio.eum
    mikeio.generic
    mikeio._track
    mikeio._options
    mikeio._time
    mikeio._interpolation
    mikeio._path
    mikeio._deprecation
    mikeio.exceptions
forbidden_modules = matplotlib
# The file modules reach matplotlib through dataset; only the direct import is checked.
allow_indirect_imports = True
